{
  "name": "floating-lyrics",
  "version": "0.1.0-alpha.1",
  "description": "Synced lyrics that float above your desktop, plus a Focus Island for Spotify, Apple Music and YouTube Music. Tauri + React.",
  "private": true,
  "license": "MIT",
  "author": "Mahrus Rohisyam",
  "homepage": "https://github.com/mahrus-rohisyam/floating-lyrics-desktop#readme",
