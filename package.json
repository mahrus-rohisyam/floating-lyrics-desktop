  },
  "bugs": {
    "url": "https://github.com/mahrus-rohisyam/floating-lyrics-desktop/issues"
  },
  "keywords": [
    "lyrics",
    "synced-lyrics",
    "lrc",
    "overlay",
    "desktop",
