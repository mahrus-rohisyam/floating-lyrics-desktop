{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Floating Lyrics Preview",
    "version": "0.1.0-alpha.1",
    "identifier": "com.floatinglyrics.preview",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "Floating Lyrics",
                "width": 1240,
                "height": 860,
                "minWidth": 360,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.png"
        ],
        "macOS": {
            "minimumSystemVersion": "13.0",
            "entitlements": "Entitlements.plist",
            "infoPlist": "Info.plist"
        },
        "publisher": "Mahrus Rohisyam",
        "copyright": "Copyright (c) 2026 Mahrus Rohisyam. MIT License.",
        "category": "Music",
        "shortDescription": "Synced lyrics floating above your desktop",
        "homepage": "https://github.com/mahrus-rohisyam/floating-lyrics-desktop"
    }
}
